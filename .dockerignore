# Git / IDE
.git
.gitignore
.cursor
.idea
.vscode
*.swp

# Local env and secrets
.env
.env.*

# Python caches / venvs
.venv
venv
__pycache__
*.py[cod]
*.egg-info
.eggs
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
dist
build

# Runtime data (bind-mounted at run time)
data/rag_storage/**
data/inputs/**
!data/rag_storage/.gitkeep
!data/inputs/.gitkeep

# Docs / tests not needed in the runtime image context
# (keep README/LICENSE — copied explicitly for package metadata)
tests
scripts
docs
*.md
!README.md
# MIT requires the upstream notices to travel with every copy, image included.
!THIRD_PARTY_LICENSES.md
agent-transcripts
*.log

# Web UI build inputs: the bundle is produced by the node stage inside the image,
# so the host's dependency tree must never enter the build context.
web/node_modules
web/dist
