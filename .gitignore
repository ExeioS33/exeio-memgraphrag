# Runtime data
data/rag_storage/**
!data/rag_storage/.gitkeep
# Generated working dirs and evaluation artefacts: doc examples, scripts/e2e_arxiv.py,
# scripts/evaluate.py (data/eval/) and scripts/bench.py (data/eval_storage/).
data/rag_storage_*/
data/eval/
data/eval_storage/
data/inputs/**
!data/inputs/.gitkeep
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Local corporate TLS inspection CAs (not committed)
certs/*.crt
certs/*.pem
certs/*.cer
!certs/.gitkeep

# RFE ingestion working artefacts (imported sidecars, DB snapshots)
data/rfe/

# Web UI: dependencies and build output are artefacts, never committed.
# The bundle would also trip the check-added-large-files pre-commit hook (1 MiB).
web/node_modules/
web/dist/
memgraphrag/api/static/
