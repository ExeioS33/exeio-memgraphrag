        <mxCell id="p2_warn" value="&lt;b&gt;⚠ memory_sub_stage n&apos;est pas un indicateur de progression&lt;/b&gt;&lt;br&gt;&lt;br&gt;Les sept libellés — openie → memory_build → schema_extraction → ontology_filter → conflict_detection → conflict_resolution → graph_install — sont écrits dans une boucle serrée &lt;i&gt;avant&lt;/i&gt; l&apos;appel d&apos;indexation.&lt;br&gt;&lt;br&gt;Un sondage de statut renvoie donc graph_install pendant quasiment toute la durée du traitement." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="925" width="320" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p2_processed" value="&lt;b&gt;PROCESSED&lt;/b&gt;&lt;br&gt;memory_sub_stage = done&lt;br&gt;chunk_ids enregistrés" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="925" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2_failed" value="&lt;b&gt;FAILED&lt;/b&gt;&lt;br&gt;metadata.error&lt;br&gt;memory_sub_stage = None" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="790" y="925" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p2_lock" value="&lt;b&gt;Concurrence&lt;/b&gt;&lt;br&gt;&lt;br&gt;pipeline_lock est un verrou &lt;i&gt;par processus&lt;/i&gt; : il ne protège rien entre workers.&lt;br&gt;&lt;br&gt;Le contrôle « occupé » est lecture-puis-acquisition : une requête qui perd la course attend le verrou au lieu de renvoyer 409. Le 409 est l&apos;usage courant, pas une garantie." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1140" y="925" width="320" height="185" as="geometry"/>
