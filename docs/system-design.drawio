        <mxCell id="p3_title" value="Chemin de requête — core.aquery() / _retrieve_one()" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="-95" width="1200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p3_subtitle" value="Quatre modes : ppr (défaut) · naive · context · bypass. Sur /api/*, le mode est décodé depuis un préfixe dans le texte de la requête." style="text;html=1;fontSize=13;fontStyle=2;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="-55" width="1200" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="p3_q1" value="POST /query&#xa;/query/data (contexte seul)&#xa;/query/stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p3_q2" value="POST /api/generate · /api/chat&#xa;parse_query_mode() décode&#xa;/ppr /naive /context /bypass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="340" height="70" as="geometry"/>
