### MemGraphRAG environment sample
### Copy to .env and edit. OS environment variables take precedence over .env.
### Project-owned vars use MEMGRAPHRAG_ prefix; infrastructure/binding vars
### keep LightRAG naming (POSTGRES_*, NEO4J_*, LLM_*, EMBEDDING_*, DOCLING_*, CHUNK_*).
###
### For a richer local-testing template (lab Ollama/Docling examples, compose
### publish ports, gunicorn knobs), see `.env.example`. Keep required keys in sync.

###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=9621
# Docker image tag for compose builds (exeio-memgraphrag:<version>)
# MEMGRAPHRAG_VERSION=0.1.0
# WORKERS=2
# TIMEOUT=150
# CORS_ORIGINS=*
WORKING_DIR=./data/rag_storage
INPUT_DIR=./data/inputs
# LOG_LEVEL=INFO
# SSL=false
# SSL_CERTFILE=
# SSL_KEYFILE=
# Outbound TLS (LLM/embed/Docling/clients URL-ingest). Corporate inspection:
# Place your Fortinet/Zscaler CA at ./certs/corporate-ca.crt (gitignored), or set:
# MEMGRAPHRAG_SSL_CERT_FILE=/path/to/Fortinet_CA_SSL.crt
# SSL_CERT_FILE=/path/to/Fortinet_CA_SSL.crt
# SSL_VERIFY=true
# SSL_VERIFY=false  # lab-only escape hatch (insecure)
# OpenSSL 3 / Python 3.13: custom CA paths auto-relax VERIFY_X509_STRICT (AKI).

###########################
### Auth (JWT and/or API key)
###########################
# AUTH_ACCOUNTS=admin:change_me
# TOKEN_SECRET=change-me-to-a-long-random-string
# JWT_ALGORITHM=HS256
# TOKEN_EXPIRE_HOURS=48
# GUEST_TOKEN_EXPIRE_HOURS=24
# MEMGRAPHRAG_API_KEY=
# WHITELIST_PATHS=/health,/docs,/openapi.json
# WARNING: never add /api/* here. The Ollama router is mounted on /api and its
# /api/chat and /api/generate routes call the billed LLM (/bypass skips retrieval
# entirely). The whitelist short-circuits BEFORE any token or API-key check.
# Fail closed: refuse to serve unauthenticated requests even if the .env failed to
# load (e.g. the process was started from another working directory).
# REQUIRE_AUTH=false

###########################
### Query / retrieval (MemGraphRAG-native)
###########################
TOP_K=10
LINKING_TOP_K=50
PASSAGE_NODE_WEIGHT=0.05
DAMPING=0.5
FACT_SIMILARITY_THRESHOLD=0.6
SKIP_FACT_RERANK=true
PPR_ENGINE=igraph
ENABLE_LLM_CACHE=true

###########################
### LLM binding (OpenAI-compatible)
###########################
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=150
MAX_ASYNC_LLM=4
# OPENAI_API_KEY=

### --- vLLM (self-hosted OpenAI-compatible, e.g. Mistral GPTQ INT4) ---
### Compose service example: vllm-mistal → host port 8001 → container :8000
### served-model-name: mistral  |  max-model-len: 16384  |  data-parallel-size: 2
# VLLM_HOST=localhost
# VLLM_PORT=8001
# VLLM_BASE_URL=http://${VLLM_HOST}:${VLLM_PORT}/v1
# VLLM_API_KEY=EMPTY
# VLLM_SERVED_MODEL_NAME=mistral
# VLLM_MAX_MODEL_LEN=16384
# VLLM_DTYPE=float16
# VLLM_DATA_PARALLEL_SIZE=2
# VLLM_TENSOR_PARALLEL_SIZE=1
# VLLM_MAX_NUM_SEQS=128
# VLLM_MAX_NUM_BATCHED_TOKENS=16384
# VLLM_GPU_MEMORY_UTILIZATION=0.9
# VLLM_ENABLE_CHUNKED_PREFILL=true
# VLLM_ENABLE_PREFIX_CACHING=true
### Hugging Face weights used by the vLLM container (not read by MemGraphRAG itself):
# HF_TOKEN=
# MISTRAL_MODEL_7B_GPTQ_4=TheBloke/Mistral-7B-Instruct-v0.2-GPTQ
### Point MemGraphRAG LLM at vLLM (REQUIRED — VLLM_* alone is not read by the app):
# LLM_BINDING=openai
# LLM_BINDING_HOST=http://localhost:8001/v1
# LLM_BINDING_API_KEY=EMPTY
# LLM_MODEL=mistral
# LLM_TIMEOUT=300
# MAX_ASYNC_LLM=8
### Then: docker compose up -d memgraphrag  (Compose injects LLM_* into the container)

###########################
### Embedding binding (OpenAI-compatible)
###########################
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_MAX_TOKENS=512
# EMBEDDING_SEND_DIMENSIONS=true
### Note: the Mistral vLLM service above is chat/completions only — keep a
### separate embedding endpoint (OpenAI / Together / Ollama / embedding vLLM).

###########################
### Storage selection
###########################
### Defaults (no external DB): JsonKVStorage, NanoVectorDBStorage, IgraphStorage, JsonDocStatusStorage
### Compose stack:
# MEMGRAPHRAG_KV_STORAGE=PGKVStorage
# MEMGRAPHRAG_VECTOR_STORAGE=PGVectorStorage
# MEMGRAPHRAG_GRAPH_STORAGE=Neo4JStorage
# MEMGRAPHRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
# PPR_ENGINE=neo4j_gds
MEMGRAPHRAG_KV_STORAGE=JsonKVStorage
MEMGRAPHRAG_VECTOR_STORAGE=NanoVectorDBStorage
MEMGRAPHRAG_GRAPH_STORAGE=IgraphStorage
MEMGRAPHRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
# WORKSPACE=

###########################
### PostgreSQL (+ pgvector)
###########################
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
# REQUIRED by docker-compose.yml (no default any more).
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=rag
# POSTGRES_VECTOR_INDEX_TYPE=hnsw
# Published on 127.0.0.1 by default; set the ADDR to 0.0.0.0 to expose deliberately.
# POSTGRES_PUBLISH_ADDR=127.0.0.1
# POSTGRES_PUBLISH_PORT=5432

###########################
### Neo4j (+ GDS plugin for PPR_ENGINE=neo4j_gds)
###########################
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
# REQUIRED by docker-compose.yml (no default any more).
NEO4J_PASSWORD=change-me
# Published on 127.0.0.1 by default (gds.* runs unrestricted on this instance).
# NEO4J_PUBLISH_ADDR=127.0.0.1
# NEO4J_DATABASE=neo4j
# NEO4J_WORKSPACE=
# NEO4J_MAX_CONNECTION_POOL_SIZE=50
# NEO4J_CONNECTION_TIMEOUT=30.0
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687

###########################
### File processing / chunking
###########################
# MEMGRAPHRAG_PARSER=*:legacy-F
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
# CHUNK_F_SIZE=1200
# CHUNK_F_OVERLAP_SIZE=100
# CHUNK_R_SIZE=1200
# CHUNK_R_OVERLAP_SIZE=100
# CHUNK_P_SIZE=1200
# CHUNK_P_OVERLAP_SIZE=100
# PDF_DECRYPT_PASSWORD=
# TIKTOKEN_CACHE_DIR=
# TIKTOKEN_MODEL=gpt-4o-mini
# MAX_PARALLEL_INSERT=2

###########################
### Docling (optional remote parser)
###########################
# DOCLING_ENDPOINT=http://localhost:5001
# DOCLING_DO_OCR=true
# DOCLING_FORCE_OCR=false
# DOCLING_ADDITIONAL_SUFFIXES=
# DOCLING_POLL_INTERVAL_SECONDS=2
# DOCLING_MAX_POLLS=300
# MAX_PARALLEL_PARSE_DOCLING=1
# MEMGRAPHRAG_FORCE_REPARSE_DOCLING=false
# DOCLING_PUBLISH_ADDR=127.0.0.1
# DOCLING_PUBLISH_PORT=5001
# From compose (memgraphrag → docling profile service):
# DOCLING_ENDPOINT=http://docling:5001

###########################
### Langfuse observability (retrieval traces)
###########################
# When enabled, query/retrieval stages emit nested Langfuse observations.
# Requires `langfuse` (included in the [api] extra).
# LANGFUSE_ENABLE_TRACE=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

###########################
### Ollama emulation
###########################
# OLLAMA_EMULATING_MODEL_NAME=memgraphrag
# OLLAMA_EMULATING_MODEL_TAG=latest

###########################
### Gunicorn (optional)
###########################
# MEMGRAPHRAG_GUNICORN_BIND=0.0.0.0:9621
# MEMGRAPHRAG_GUNICORN_WORKERS=1
# MEMGRAPHRAG_GUNICORN_LOGLEVEL=info
# ACCESS_LOG=-
# ERROR_LOG=-
