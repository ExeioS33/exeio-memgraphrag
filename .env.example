### MemGraphRAG local / testing environment template
### Copy to `.env` and edit. OS environment variables take precedence over `.env`.
### Project-owned vars use MEMGRAPHRAG_ prefix; infrastructure/binding vars
### keep LightRAG naming (POSTGRES_*, NEO4J_*, LLM_*, EMBEDDING_*, DOCLING_*, CHUNK_*).
###
### Prefer this file for local unit tests + server smoke tests (file-backed storage).
### `env.example` is the same key set as the clean committed sample — keep them in sync.
### Secrets stay empty or clearly fake; never commit a real `.env`.

###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=9621
# WORKERS=1
# TIMEOUT=150
# CORS_ORIGINS=*
WORKING_DIR=./data/rag_storage
INPUT_DIR=./data/inputs
# LOG_LEVEL=INFO
# SSL=false
# SSL_CERTFILE=
# SSL_KEYFILE=
# Outbound TLS (LLM/embed/Docling). For corporate inspection CA:
# SSL_CERT_FILE=/path/to/ca-or-bundle.pem
# SSL_VERIFY=true

###########################
### Auth (JWT and/or API key) — leave unset for open local tests
###########################
# AUTH_ACCOUNTS=admin:change_me
# TOKEN_SECRET=change-me-to-a-long-random-string
# JWT_ALGORITHM=HS256
# TOKEN_EXPIRE_HOURS=48
# GUEST_TOKEN_EXPIRE_HOURS=24
# MEMGRAPHRAG_API_KEY=
# WHITELIST_PATHS=/health,/docs,/openapi.json,/api/*

###########################
### Query / retrieval (MemGraphRAG-native)
###########################
TOP_K=10
LINKING_TOP_K=50
PASSAGE_NODE_WEIGHT=0.05
DAMPING=0.5
FACT_SIMILARITY_THRESHOLD=0.6
SKIP_FACT_RERANK=true
PPR_ENGINE=igraph
ENABLE_LLM_CACHE=true

###########################
### LLM binding (OpenAI-compatible)
###########################
### Default: public OpenAI API. For local Ollama OpenAI-compat, see lab examples below.
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=150
MAX_ASYNC_LLM=4
# OPENAI_API_KEY=

### Lab / local testing hosts (examples — uncomment and point at your lab)
### Ollama OpenAI-compatible API (typical port 11434):
# LLM_BINDING=openai
# LLM_BINDING_HOST=http://localhost:11434/v1
# LLM_BINDING_API_KEY=ollama
# LLM_MODEL=llama3.2
### cf-lab style remote Ollama (replace host):
# LLM_BINDING_HOST=http://cf-lab.example:11434/v1
# LLM_BINDING_API_KEY=ollama

###########################
### Embedding binding (OpenAI-compatible)
###########################
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# EMBEDDING_MAX_TOKENS=512
# EMBEDDING_SEND_DIMENSIONS=true
# EMBEDDING_QUERY_PREFIX=
### Local Ollama embeddings example:
# EMBEDDING_BINDING=openai
# EMBEDDING_BINDING_HOST=http://localhost:11434/v1
# EMBEDDING_BINDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768

###########################
### Storage selection (file-backed defaults for unit tests)
###########################
### Defaults (no external DB): JsonKVStorage, NanoVectorDBStorage, IgraphStorage, JsonDocStatusStorage
MEMGRAPHRAG_KV_STORAGE=JsonKVStorage
MEMGRAPHRAG_VECTOR_STORAGE=NanoVectorDBStorage
MEMGRAPHRAG_GRAPH_STORAGE=IgraphStorage
MEMGRAPHRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
# WORKSPACE=

### Compose / integration overrides (uncomment when docker compose stack is up):
# MEMGRAPHRAG_KV_STORAGE=PGKVStorage
# MEMGRAPHRAG_VECTOR_STORAGE=PGVectorStorage
# MEMGRAPHRAG_GRAPH_STORAGE=Neo4JStorage
# MEMGRAPHRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
# PPR_ENGINE=neo4j_gds

###########################
### PostgreSQL (+ pgvector) — used when PG* storages are selected
###########################
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DATABASE=rag
# POSTGRES_VECTOR_INDEX_TYPE=hnsw
### Compose publish port (host → container):
# POSTGRES_PUBLISH_PORT=5432

###########################
### Neo4j (+ GDS plugin for PPR_ENGINE=neo4j_gds)
###########################
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=memgraphrag
# NEO4J_DATABASE=neo4j
# NEO4J_WORKSPACE=
# NEO4J_MAX_CONNECTION_POOL_SIZE=50
# NEO4J_CONNECTION_TIMEOUT=30.0
### Compose publish ports:
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687

###########################
### File processing / chunking
###########################
# MEMGRAPHRAG_PARSER=*:legacy-F
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
# CHUNK_F_SIZE=1200
# CHUNK_F_OVERLAP_SIZE=100
# CHUNK_R_SIZE=1200
# CHUNK_R_OVERLAP_SIZE=100
# CHUNK_P_SIZE=1200
# CHUNK_P_OVERLAP_SIZE=100
# PDF_DECRYPT_PASSWORD=
# TIKTOKEN_CACHE_DIR=
# TIKTOKEN_MODEL=gpt-4o-mini
# MAX_PARALLEL_INSERT=2

###########################
### Docling (optional remote parser)
###########################
# Local compose profile: docker compose --profile docling up -d
# DOCLING_ENDPOINT=http://localhost:5001
# DOCLING_DO_OCR=true
# DOCLING_FORCE_OCR=false
# DOCLING_ADDITIONAL_SUFFIXES=
# DOCLING_POLL_INTERVAL_SECONDS=2
# DOCLING_MAX_POLLS=300
# MAX_PARALLEL_PARSE_DOCLING=1
# MEMGRAPHRAG_FORCE_REPARSE_DOCLING=false
# DOCLING_PUBLISH_PORT=5001
### cf-lab / remote Docling example (replace host):
# DOCLING_ENDPOINT=http://cf-lab.example:5001
### From inside compose memgraphrag service talking to profile docling:
# DOCLING_ENDPOINT=http://docling:5001

###########################
### Langfuse observability (retrieval traces)
###########################
# LANGFUSE_ENABLE_TRACE=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

###########################
### Ollama emulation (server exposes Ollama-compatible /api/*)
###########################
# OLLAMA_EMULATING_MODEL_NAME=memgraphrag
# OLLAMA_EMULATING_MODEL_TAG=latest

###########################
### Gunicorn (optional; used by memgraphrag-server multi-worker path)
###########################
# MEMGRAPHRAG_GUNICORN_BIND=0.0.0.0:9621
# MEMGRAPHRAG_GUNICORN_WORKERS=1
# MEMGRAPHRAG_GUNICORN_LOGLEVEL=info
# ACCESS_LOG=-
# ERROR_LOG=-
